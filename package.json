{
  "name": "lexilearn-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.3.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "bundle": "rm -rf .bundle lexilearn-ai.zip && mkdir -p .bundle/lexilearn-ai && git ls-files -z | xargs -0 cp --parents -t .bundle/lexilearn-ai && (cd .bundle && zip -qr ../lexilearn-ai.zip lexilearn-ai) && rm -rf .bundle",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "jose": "^6.2.15",
    "mongodb": "^7.8.0",
    "next": "^16.0.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "youtube-transcript-plus": "^2.0.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
