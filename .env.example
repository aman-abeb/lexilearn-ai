# Optional. Default: .data inside the project root.
# Local JSON storage is for course materials on this machine.
LEXILEARN_DATA_DIR=.data

# Optional AI lecture compilation and multiple-choice questions. Leave the key empty to read and organize
# sources without making model requests. Keep all provider settings server-only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible API root. The server appends /chat/completions.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Account database for Google sign-in, reading preferences, and saved progress.
# Example: mongodb://127.0.0.1:27017/lexilearn
MONGODB_URI=

# Signs the web session cookie and the mobile bearer token. Use at least 32 random characters.
# openssl rand -base64 32
AUTH_SECRET=

# Web Google client ID. Set the same value in both variables.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional comma-separated iOS and Android Google client IDs.
# The mobile app sends Google's ID token to POST /api/auth/google.
GOOGLE_MOBILE_CLIENT_IDS=
