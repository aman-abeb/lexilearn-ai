# Optional path to an old materials.json. Used once, when the database has no courses yet.
# After that import, courses and lectures are stored in MongoDB.
LEXILEARN_DATA_DIR=.data

# Optional AI lecture compilation, read-aloud, study help, and exam questions.
# Leave the keys empty to read and organize sources without model requests.
# Keep all provider settings server-only.
# Study tools, exam questions, and compilation use Grok when XAI_API_KEY is set.
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1
# Used for study tools only when XAI_API_KEY is empty. Lexi’s voice always uses the Grok key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible API root. The server appends /chat/completions.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Database for courses, lectures, accounts, reading preferences, and saved progress.
# Include the database name. If the URI has none, the app uses "lexilearn".
# Example: mongodb://127.0.0.1:27017/lexilearn
# Example: mongodb+srv://USER:PASSWORD@cluster.example.net/lexilearn
MONGODB_URI=

# Signs the web session cookie and the mobile bearer token. Use at least 32 random characters.
# openssl rand -base64 32
AUTH_SECRET=

# Web Google client ID from Google Cloud (OAuth client, application type Web).
# Put the same value in both variables. If GOOGLE_CLIENT_ID is empty, the server
# accepts NEXT_PUBLIC_GOOGLE_CLIENT_ID. Restart the dev server after changing these.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional comma-separated iOS and Android Google client IDs.
# The mobile app sends Google's ID token to POST /api/auth/google.
GOOGLE_MOBILE_CLIENT_IDS=

# Optional comma-separated Google emails that stay admins.
# The first signed-in account is an admin when this list is empty.
ADMIN_EMAILS=

# Server-only admin sign-in. Use at least 12 characters for the password.
# This account is always an admin. Restart the server after changing it.
ADMIN_EMAIL=
ADMIN_PASSWORD=
